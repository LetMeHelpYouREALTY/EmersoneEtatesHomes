
# Environment Variables Template
# Copy to .env.local for local development

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://emersonestateshomes.com
NEXT_PUBLIC_SITE_NAME="Emerson Estates"

# Contact Form (if using external service)
# CONTACT_API_KEY=your_api_key_here
# EMAIL_SERVICE_URL=your_email_service_url

# Analytics (optional)
NEXT_PUBLIC_GA_ID=G-9CKG30GVQR
# NEXT_PUBLIC_GTM_ID=your_google_tag_manager_id

# WordPress Engine Stream Details
NEXT_PUBLIC_STREAM_URL=https://drjanlasvegas.wpengine.com
NEXT_PUBLIC_STREAM_ID=6046540560

# RealScout Integration (required for property listings)
NEXT_PUBLIC_REALSCOUT_AGENT_ID=your_agent_encoded_id_here
# REALSCOUT_API_KEY=your_realscout_api_key  
# REALSCOUT_WIDGET_ID=your_widget_id

# Widget Configuration
NEXT_PUBLIC_ENABLE_CALCULATOR=true
NEXT_PUBLIC_ENABLE_MARKET_STATS=true
NEXT_PUBLIC_ENABLE_IMAGE_GALLERY=true

# Analytics & Tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_TRACK_WIDGET_INTERACTIONS=true
